DATABASE_URL="postgresql://postgres@localhost:5432/audit_workflow?schema=public"

JWT_SECRET="change-me"
JWT_EXPIRES_IN="8h"

PORT=3000

# Where uploaded documents live. "local" (default) writes to disk at
# UPLOAD_DIR — fine for local dev, but an ephemeral deploy host wipes it on
# every redeploy. Set to "supabase" in a deployed environment and fill in
# the three SUPABASE_* vars below instead — see src/storage/.
STORAGE_DRIVER="local"
UPLOAD_DIR="uploads"

# Only read when STORAGE_DRIVER=supabase.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="documents"
